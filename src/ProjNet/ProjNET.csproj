<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProjNet</RootNamespace>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <IsTrimmable Condition="'$(TargetFramework)' == 'net8.0'">true</IsTrimmable>
    <EnableTrimAnalyzer Condition="'$(TargetFramework)' == 'net8.0'">true</EnableTrimAnalyzer>
    <SignAssembly>true</SignAssembly>
	  <EnablePackageValidation>true</EnablePackageValidation>
	  <PackageValidationBaselineVersion>2.1.0</PackageValidationBaselineVersion>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>


  <PropertyGroup Label="Target Framework Policy">
    <RequiredShippingTargetFramework>netstandard2.0</RequiredShippingTargetFramework>
    <ApprovedTargetFrameworks>netstandard2.0;netstandard2.1;net8.0</ApprovedTargetFrameworks>
  </PropertyGroup>

  <Target Name="ValidateTargetFrameworkPolicy" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(TargetFrameworks)' == ''" Text="ProjNET must define TargetFrameworks explicitly to enforce target policy." />
    <Error Condition="'$(TargetFrameworks)' != '$(ApprovedTargetFrameworks)'"
           Text="ProjNET target framework policy violation. Current: '$(TargetFrameworks)'. Approved: '$(ApprovedTargetFrameworks)'. Update src/ProjNet/ENGINEERING_GOVERNANCE.md when intentionally changing this policy." />
    <Error Condition="$([System.String]::Copy('$(TargetFrameworks)').Contains('$(RequiredShippingTargetFramework)')) != 'True'"
           Text="ProjNET must ship the required target framework '$(RequiredShippingTargetFramework)'." />
  </Target>

  <PropertyGroup Label="Assembly Info">
    <AssemblyTitle>Proj.NET</AssemblyTitle>
    <Description>Proj.NET performs point-to-point coordinate conversions between geodetic coordinate systems for use in .Net, Geographic Information Systems (GIS) or GPS applications. The spatial reference model used adheres to the Simple Features specification.</Description>
  </PropertyGroup>

  <PropertyGroup Label="NuGet Package Info">
    <PackageId>ProjNET</PackageId>
    <Authors>Morten Nielsen, NetTopologySuite-Team</Authors>
    <PackageLicenseExpression>LGPL-2.1-or-later</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageDescription>.NET Spatial Reference and Projection Engine.
Proj.NET performs point-to-point coordinate conversions between geodetic coordinate systems for use in fx. Geographic Information Systems (GIS) or GPS applications. The spatial reference model used adheres to the Simple Features specification.
    </PackageDescription>
    <PackageTags>OGC;SFS;Projection</PackageTags>
    <PackageProjectUrl>https://github.com/NetTopologySuite/ProjNet4GeoAPI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NetTopologySuite/ProjNet4GeoAPI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" />
    <PackageReference Include="Microsoft.Bcl.Memory" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BitMiracle.LibTiff.NET" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProjNET.Tests" Key="" />
  </ItemGroup>

</Project>
